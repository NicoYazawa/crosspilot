# CrossPilot 数据库迁移容器
# 只包含 migrate 二进制，连接 postgres 执行 up/down 后退出
#
# 用法: docker compose run --rm migrate up

FROM golang:1.27-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN GOPROXY=https://goproxy.cn,direct go mod download
COPY . .
ARG CGO_ENABLED=0
RUN go build -ldflags="-s -w" -o /crosspilot-migrate ./cmd/migrate

FROM alpine:3.23.5
RUN apk add --no-cache ca-certificates postgresql-client
WORKDIR /app
COPY --from=build /crosspilot-migrate /app/
ENTRYPOINT ["/app/crosspilot-migrate"]
