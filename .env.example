# =============================================================================
# CrossPilot 环境变量模板
#
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进入版本库。
# 密钥只保存在本机或服务端，不要提交到仓库。
#
# 所有 VITE_* 配置都会进入浏览器构建产物，不得存放服务端密钥。
# =============================================================================

# -----------------------------------------------------------------------------
# 运行时
# -----------------------------------------------------------------------------
CROSSPILOT_ENV=development
CROSSPILOT_HTTP_ADDR=:8000
CROSSPILOT_LOG_LEVEL=info
CROSSPILOT_LOG_FORMAT=json
CROSSPILOT_SHUTDOWN_TIMEOUT=10s

# 允许跨域访问的来源，逗号分隔。留空表示不允许任何跨域来源。
# 只接受完整来源（协议 + 主机），不支持通配符。
CROSSPILOT_HTTP_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crosspilot
POSTGRES_PASSWORD=
POSTGRES_DB=crosspilot
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=20

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_PRODUCT_COLLECTION=crosspilot_products
QDRANT_CATEGORY_KB_COLLECTION=crosspilot_category_kb

# -----------------------------------------------------------------------------
# 模型网关
# 多家供应商并存：跨 OpenAI 兼容协议与 Anthropic Messages 两种协议族
# -----------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=qwen

LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen3-max

LLM_MINIMAX_BASE_URL=https://api.minimax.chat/v1
LLM_MINIMAX_API_KEY=
LLM_MINIMAX_MODEL=MiniMax-M2

LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat

LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-sonnet-5-5

LLM_REQUEST_TIMEOUT=60s
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# 身份
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=
AUTH_JWT_TYP=crosspilot-access+jwt
AUTH_ACCESS_TOKEN_TTL=24h

# -----------------------------------------------------------------------------
# 可观测：OTLP 直连，不经过 collector。留空则关闭上报。
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crosspilot-api
OTEL_TRACES_SAMPLER_ARG=1.0
