# CrossPilot 环境变量清单
# 复制为 .env 后填写实际值
# docker compose up -d --build 前必须设置必填项

# ============ 必填 ============

# JWT 签名密钥（生产必须使用随机字符串，>=32 字符）
AUTH_JWT_SECRET=change-me-in-production

# LLM API Keys（至少配置一个）
QWEN_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 数据库密码
POSTGRES_PASSWORD=

# ============ 可选 ============

# CORS 来源（前端开发服务器）
CORS_ORIGINS=http://localhost:5173

# LLM 默认 Provider
LLM_DEFAULT_PROVIDER=qwen

# 模型配置
QWEN_MODEL=qwen-plus
MINIMAX_MODEL=MiniMax-M2
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenTelemetry（不填则无追踪）
OTEL_EXPORTER_OTLP_ENDPOINT=
