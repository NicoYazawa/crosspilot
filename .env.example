# CrossPilot 环境变量清单
# 复制为 .env 后填写实际值
# docker compose up -d --build 前必须设置必填项

# ============ 必填 ============

# JWT 签名密钥（生产必须使用随机字符串，>=32 字符）
AUTH_JWT_SECRET=change-me-in-production

# LLM API Keys（至少配置一个）
#
# 这里是宿主侧的名字。docker-compose.yml 会把它们映射成容器内的
# LLM_QWEN_API_KEY 等前缀名——那是 internal/config/config.go 真正读的名字。
# 直接用 `docker compose up` 时改这里就行；本地 `go run ./cmd/server` 不走
# compose，需要自己 export LLM_QWEN_API_KEY=...（带前缀的那个名字）。
#
# 四家里目前只有 qwen / deepseek / minimax 的适配器（OpenAI 兼容协议族）可用；
# anthropic 是 Messages 协议族，选中它时接口回 503。
#
# 填了哪家的 key，下面的 LLM_DEFAULT_PROVIDER 就要改成哪家：两者不一致时
# 后端会去读一个空的 key，以 503 model_unavailable 收场（不是故障，是没配对）。
QWEN_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 数据库密码
POSTGRES_PASSWORD=

# ============ 可选 ============

# CORS 来源（前端开发服务器）
CORS_ORIGINS=http://localhost:5173

# LLM 默认 Provider
LLM_DEFAULT_PROVIDER=qwen

# 模型配置（不填则用代码里的默认值，见 config.go 的 provider()）
QWEN_MODEL=qwen3-max
MINIMAX_MODEL=MiniMax-M2
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenTelemetry（不填则无追踪）
OTEL_EXPORTER_OTLP_ENDPOINT=

# 价格表覆盖路径（不填 = 用二进制内嵌的默认表）
#
# 内嵌表在 internal/pricing/default_pricing.yaml，覆盖四家供应商的主力 model。
# 这里留空是**刻意的默认值**：外挂路径写错时价格表会静默变空、全部调用变成
# unpriced（虽然会在启动日志里 WARN），而内嵌表不存在「文件没进镜像」这种
# 失败模式。厂商调价后想不升级镜像就改价，再设这个键。
#
# 注意：model 名必须与上面的 *_MODEL 逐字一致，否则该 model 全表 unpriced。
# 例如 DEEPSEEK_MODEL=deepseek-chat 而内置表只有 deepseek-flash 时，
# 启动日志会出现「当前模型不在价格表中」的 WARN，成本看板的 unpriced_count 会涨。
PRICING_PRICEBOOK_PATH=
